        }

        .projectCategoryDropdownButton .dropdown-toggle {
            background-color: #738c1f !important;
            color: white !important;
        }

        .projectStageDropdownButton .dropdown-toggle {
            background-color: #94c5e3 !important;
            color: #333 !important;
        }

        #accomplishmentsDashboard .bootstrap-select .dropdown-toggle {
            font-size: 16px;
            font-weight: bold;
            padding-top: 15px;
            padding-bottom: 15px;
        }
        .counter-label {
            font-size: 22px;
        }


        .chartHeader {
            font-size: 20px;
        }

        .chartTitle{
            font-size: 18px;
        }

        .projectDashboardNavBar {
            position: -webkit-sticky;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .stickyHeaderNavBar {
            text-transform: uppercase;
            text-align: center;
            padding-left: 0;
            padding-right: 0;
            font-size: 20px;
        }

            .stickyHeaderNavBar ul {
                display: flex;
                flex-wrap: wrap;
                float: none;
                gap: 10px;
            }

            .stickyHeaderNavBar ul::before,
            .stickyHeaderNavBar ul::after {
                display: none;
            }

        .projectDashboardNavBar .nav li a {
            color: white;
            width: 100%
        }

        .projectDashboardNavBar .nav li {
            padding-left: 0;
            padding-right: 0;
        }

        .projectDashboardNavBar .nav li {
            background-color: #2e6580;
            color: white;
            flex-grow: 1;
            align-self: center;
            justify-content: center;
            border: 1px #1C2329 solid;
        }

            .projectDashboardNavBar .nav li.active {
                color: #2e6580;
                background-color: #edf6fb;
                text-decoration: none;
            }

                .projectDashboardNavBar .nav li.active a {
                    color: #2e6580;
                }

            .projectDashboardNavBar .nav li:hover, .projectDashboardNavBar .nav li:hover a, .projectDashboardNavBar .nav li a:hover {
                color: #2e6580;
                background-color: #edf6fb;
                text-decoration: none;
            }
        .scrollHeader {
            scroll-margin-top: 182px;
        }
        /* Counters layout */
        .counterRow {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            flex-wrap: nowrap;
        }
        .counterItem {
            text-align: center;
            box-sizing: border-box;
        }
        .counterBullet {
            display: flex;
            align-items: center;
            justify-content: center;
        }



    </style>

    <style type="text/css" media="only screen and  (max-width: 991px)">
        .counterRow {
            flex-wrap: wrap;
        }

        .counterItem {
            //flex: 0 0 50%;
            padding: 6px 8px;
        }

            .counterItem.jobs {
                order: 3;
                flex-basis: 100%;
            }

        .counterBullet {
            display: none;
        }
    </style>
    <style type="text/css" media="only screen and  (max-width: 768px)">

        .counterItem {
            flex: 0 0 50%;
        }
    </style>

    <style type="text/css" media="only screen and (max-width: 767px)">
