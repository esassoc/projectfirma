        }

        .nav > li > a.waterSupplyAndQualityNavLink, .navbar-nav > li > a.waterSupplyAndQualityNavLink, .nav > li > a.habitatAndClimateResilienceNavLink, .navbar-nav > li > a.habitatAndClimateResilienceNavLink {
            padding: 25px 10px 25px 10px;
        }
    </style>

    <style type="text/css" media="only screen and (min-width: 1200px)">

        .nav > li > a.projectSummaryNavLink, .navbar-nav > li > a.projectSummaryNavLink {
            padding: 25px 10px 25px 10px;
        }
    </style>
    <style type="text/css" media="only screen and (min-width: 691px) and (max-width: 991px)">

        .nav > li > a.capacityEnhancementNavLink, .navbar-nav > li > a.capacityEnhancementNavLink {
            padding: 5px 15px 5px 15px;
        }


        .nav > li > a.projectSummaryNavLink, .navbar-nav > li > a.projectSummaryNavLink {
            padding: 25px 10px 25px 10px;
        }
    </style>

    <style type="text/css" media="only screen and (min-width: 689px) and (max-width: 991px)">

        .nav > li > a.waterSupplyAndQualityNavLink, .navbar-nav > li > a.waterSupplyAndQualityNavLink {
            padding: 25px 10px 25px 10px;
        }
    </style>


    <style type="text/css" media="only screen and (min-width: 691px) and (max-width: 767px)">

        .nav > li > a.habitatAndClimateResilienceNavLink, .navbar-nav > li > a.habitatAndClimateResilienceNavLink {
            padding: 15px 15px 15px 15px;
        }
    </style>


    <style type="text/css" media="only screen and (min-width: 621px) and (max-width: 690px)">

        .nav > li > a.projectSummaryNavLink, .navbar-nav > li > a.projectSummaryNavLink {
            padding: 25px 10px 25px 10px;
        }

        .nav > li > a.capacityEnhancementNavLink, .navbar-nav > li > a.capacityEnhancementNavLink {
            padding: 5px 15px 5px 15px;
        }

        .nav > li > a.habitatAndClimateResilienceNavLink, .navbar-nav > li > a.habitatAndClimateResilienceNavLink {
            padding: 15px 15px 15px 15px;
        }
    </style>

    <style type="text/css" media="only screen and (min-width: 621px) and (max-width: 688px)">

        .nav > li > a.waterSupplyAndQualityNavLink, .navbar-nav > li > a.waterSupplyAndQualityNavLink {
            padding: 15px 10px 15px 10px;
        }
    </style>

    <style type="text/css" media="only screen and  (max-width: 620px)">
        .projectDashboardNavBar > nav > ul > li {
            width: 100%;
        }
    </style>

    <style type="text/css" media="only screen and  (min-width: 621px)">
        .projectDashboardNavBar > nav > ul > li {
            flex-basis: 0;
        }
    </style>
    <script src="/Scripts/waypoints.min.js"></script>
    <script src="/Scripts/jquery.counterup.min.js"></script>
}




<div id="accomplishmentsDashboard">

    <div class="row projectDashboardNavBar">
        <nav class="stickyHeaderNavBar">
            <ul class="nav navbar-nav ">
                <li><a href="#projectSummary" class="projectSummaryNavLink">@FieldDefinitionEnum.Project.ToType().FieldDefinitionDisplayName Summary</a></li>
                <li><a href="#capacityEnhancementAndTechincalAssistance" class="capacityEnhancementNavLink">Capacity Enhancement & Technical Assistance</a></li>
                <li><a href="#habitatAndClimateResilience" class="habitatAndClimateResilienceNavLink">Watershed & Climate Resilience</a></li>
                <li><a href="#waterSupplyAndQuality" class="waterSupplyAndQualityNavLink">Water Supply & Quality</a></li>
            </ul>
        </nav>
    </div>

    <div class="homepageHeader">
        <div class="row">
            <div class="col-sm-12 col-md-6 col-md-offset-3 text-center">
                <div class="intro-text">
                    <h1 class="subSectionName">Project Summary Dashboard</h1>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12" style="margin-top: 20px; margin-bottom: 20px;">
            @{ ViewPageContent.RenderPartialView(Html, ViewDataTyped.ViewPageContentViewData); }
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12 ">
            <span style="font-weight: bold">Filter @FieldDefinitionEnum.Project.ToType().GetFieldDefinitionLabelPluralized() By:</span>
        </div>
    </div>
    <div class="projectFiltersRow" style="margin-bottom: 50px">
        <div class="projectFiltersDropdowns">
            <div class="projectFilterItem">
                <select id="projectTypeDropdown" onchange="" class="selectpicker projectFiltersSelect projectTypeDropdownButton" data-live-search="true" data-width="auto" multiple="multiple">
                    @foreach (var projectType in ViewDataTyped.ProjectTypes)
                    {
                        <option value="@projectType.Value">@projectType.Text</option>
                    }
                </select>
            </div>
            <div class="projectFilterItem">
                <select id="projectCategoryDropdown" onchange="" class="selectpicker projectFiltersSelect projectCategoryDropdownButton" data-live-search="true" data-width="auto" multiple="multiple">
                    @foreach (var category in ViewDataTyped.ProjectCategories)
                    {
                        <option value="@category.Value">@category.Text</option>
                    }
                </select>
            </div>
            <div class="projectFilterItem">
                <select id="projectStageDropdown" class="selectpicker projectFiltersSelect projectStageDropdownButton" data-live-search="true" data-width="auto" multiple="multiple">
                    @foreach (var projectStage in ViewDataTyped.ProjectStages)
                    {
                        <option value="@projectStage.ProjectStageID">@projectStage.ProjectStageDisplayName</option>
                    }
                </select>
            </div>
        </div>
        <div style="margin-left: auto;">
            <button type="button" class="btn btn-firma btn-sm" style="background-color: #eee; color: #777;" onclick="clearFilters()">Clear Filters</button>
        </div>
    </div>

    @*<div class="row projectDashboardNavBar container-fluid">
            <nav class="stickyHeaderNavBar">
                <ul class="nav navbar-nav ">
                    <li class="col-md-3 col-sm-3 col-xs-3"><a href="#projectSummary" class="projectSummaryNavLink">@FieldDefinitionEnum.Project.ToType().FieldDefinitionDisplayName Summary</a></li>
                    <li class="col-md-3 col-sm-3 col-xs-3"><a href="#capacityEnhancementAndTechincalAssistance" class="capacityEnhancementNavLink">Capacity Enhancement & Technical Assistance</a></li>
                    <li class="col-md-3 col-sm-3 col-xs-3"><a href="#habitatAndClimateResilience" class="habitatAndClimateResilienceNavLink">Habitat & Climate Resilience</a></li>
                    <li class="col-md-3 col-sm-3 col-xs-3"><a href="#waterSupplyAndQuality" class="waterSupplyAndQualityNavLink">Water Supply & Quality</a></li>
                </ul>
            </nav>
        </div>*@

    <div class="row counterHeader scrollHeader" id="projectSummary">
        <div class="col-xs-12 text-center">
            <h4>@FieldDefinitionEnum.Project.ToType().FieldDefinitionDisplayName Summary</h4>
        </div>
    </div>

    <div id="projectDashboard" class="contentWrapper">
        <div class="row counterSection">
            <div class="col-sm-12 text-center">
                <div id="counterLoader" style="display: none">
                    <p class="systemText" style="font-size: 14px; font-weight: normal">Calculating...</p>
                </div>
                <div id="counterNumbers">
                    <div class="counterRow">
                        <div class="counterItem"><span id="totalProjects" class="counter">@ViewDataTyped.TotalProjects.ToGroupedNumeric()</span> <span class="counter-label">Total Projects</span></div>
                        <div><span class="bullet" style="margin: 0 10px;">&bull;</span></div>
                        <div class="counterItem"><span id="totalPartners" class="counter">@ViewDataTyped.TotalPartners.ToGroupedNumeric()</span> <span class="counter-label">Project Sponsors</span></div>
                        <div class="counterBullet"><span class="bullet" style="margin: 0 10px;">&bull;</span></div>
                        <div class="counterItem jobs"><span id="jobsCreatedOrMaintained" class="counter">@ViewDataTyped.JobsCreatedOrMaintained.ToGroupedNumeric()</span> <span class="counter-label">Jobs Created or Maintained</span></div>
                    </div>
                    @*<div style="padding-bottom: 10px;">
                            <span id="totalProjects" class="counter">@ViewDataTyped.TotalProjects.ToGroupedNumeric()</span> <span class="counter-label">Total Projects</span>
                            <span class="bullet" style="margin: 0 10px;">&bull;</span><br class="break" />
                            <span id="totalPartners" class="counter">@ViewDataTyped.TotalPartners.ToGroupedNumeric()</span> <span class="counter-label">Project Sponsors</span>
                        </div>*@
                    @*<div style="padding-bottom: 10px;">
                            <span>$</span><span id="totalAwarded" class="counter">@ViewDataTyped.TotalAwarded.ToGroupedNumeric()</span> <span class="counter-label">Funding for NCRP Projects</span>
                            <span class="bullet" style="margin: 0 10px;">&bull;</span><br class="break" />
                            <span>$</span><span id="totalMatched" class="counter">@ViewDataTyped.TotalMatched.ToGroupedNumeric()</span> <span class="counter-label">Total Matched</span>
                            <span class="bullet" style="margin: 0 10px;">&bull;</span><br class="break" />
                            <span>$</span><span id="totalInvestment" class="counter">@ViewDataTyped.TotalInvestment.ToGroupedNumeric()</span> <span class="counter-label">Total Investment</span>
                        </div>*@
                    @*<div>
                            <span>$</span><span id="totalLeveraged" class="counter">@ViewDataTyped.TotalLeveraged.ToGroupedNumeric()</span> <span class="counter-label">Total Leveraged</span>
                            <span class="bullet" style="margin: 0 10px;">&bull;</span><br class="break" />
                            <span id="jobsCreatedOrMaintained" class="counter">@ViewDataTyped.JobsCreatedOrMaintained.ToGroupedNumeric()</span> <span class="counter-label">Jobs Created or Maintained</span>
                        </div>*@
                </div>
            </div>
        </div>

        <div id="projectDashboardCharts" class="contentWrapper">
            @{ ProjectDashboardCharts.RenderPartialView(Html, ViewDataTyped.ProjectDashboardChartsViewData); }
        </div>

        <div class="row" style="margin-top: 50px">
            <div class="col-md-12">
                <div class="panel panelFirma">
                    <div class="panel-heading panelTitle">
                        <h2>@FieldDefinitionEnum.Project.ToType().GetFieldDefinitionLabelPluralized() Matching Selected Filters</h2>
                    </div>
                    <div class="panel-body">
                        @Html.AgGrid(ViewDataTyped.ProjectCustomDefaultGridSpec, ViewDataTyped.ProjectCustomDefaultGridName, ViewDataTyped.ProjectCustomDefaultGridDataUrl, "height: 650px", AgGridResizeType.VerticalResizableHorizontalAutoFit, !ViewDataTyped.CurrentFirmaSession.IsAnonymousUser())
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>

    // <![CDATA[
    function loadProjectSummary()
    {
        var projectStageIDs = jQuery("#projectStageDropdown").val();
        var projectTypes = jQuery("#projectTypeDropdown").val();
        var projectCategories = jQuery("#projectCategoryDropdown").val();
        var urlWithPlaceholder = @Html.Raw(ViewDataTyped.ProjectDashboardSummaryUrl.ToJS());
        var newUrl = urlWithPlaceholder.replace("@ProjectDashboardViewData.ProjectStagesQueryStringValuePlaceholder", projectStageIDs)
            .replace("@ProjectDashboardViewData.ProjectTypesQueryStringValuePlaceholder", projectTypes)
            .replace("@ProjectDashboardViewData.ProjectCategoriesQueryStringValuePlaceholder", projectCategories);

        SitkaAjax.get(newUrl, function (result) {
            jQuery("#totalProjects").html(result.ProjectCount);
            jQuery("#totalPartners").html(result.PartnerCount);
            jQuery("#totalAwarded").html(result.TotalAwarded);
            jQuery("#totalMatched").html(result.TotalMatched);
            jQuery("#totalInvestment").html(result.TotalInvestment);
            jQuery("#totalLeveraged").html(result.TotalLeveraged);
            jQuery("#jobsCreatedOrMaintained").html(result.JobsCreatedOrMaintained);

            jQuery("#counterLoader").hide();
            jQuery("#counterNumbers").show();
        });
    };

    function loadProjectGrid() {
        var projectStageIDs = jQuery("#projectStageDropdown").val();
        var projectTypes = jQuery("#projectTypeDropdown").val();
        var projectCategories = jQuery("#projectCategoryDropdown").val();
        var urlWithPlaceholder = @Html.Raw(ViewDataTyped.ReloadProjectGridDataUrl.ToJS());
        var newUrl = urlWithPlaceholder.replace("@ProjectDashboardViewData.ProjectStagesQueryStringValuePlaceholder", projectStageIDs)
            .replace("@ProjectDashboardViewData.ProjectTypesQueryStringValuePlaceholder", projectTypes)
            .replace("@ProjectDashboardViewData.ProjectCategoriesQueryStringValuePlaceholder", projectCategories);
        // reload grid data
        @(ViewDataTyped.ProjectCustomDefaultGridName)LoadGridData(newUrl);
        @(ViewDataTyped.ProjectCustomDefaultGridName)GridOptionsApi.setGridOption("loading", true);
    }

    function loadCharts()
    {
        var projectStageIDs = jQuery("#projectStageDropdown").val();
        var projectTypes = jQuery("#projectTypeDropdown").val();
        var projectCategories = jQuery("#projectCategoryDropdown").val();
        var urlWithPlaceholder = @Html.Raw(ViewDataTyped.ProjectDashboardChartsUrl.ToJS());
        var newUrl = urlWithPlaceholder.replace("@ProjectDashboardViewData.ProjectStagesQueryStringValuePlaceholder", projectStageIDs)
            .replace("@ProjectDashboardViewData.ProjectTypesQueryStringValuePlaceholder", projectTypes)
            .replace("@ProjectDashboardViewData.ProjectCategoriesQueryStringValuePlaceholder", projectCategories);

        SitkaAjax.load(jQuery("#projectDashboardCharts"), newUrl);
    }

    function reloadWithNewDropdowns() {
        jQuery("#counterLoader").show();
        jQuery("#counterNumbers").hide();
        loadProjectSummary();
        loadProjectGrid();
        loadCharts();
    }

    function clearFilters() {
        $(".selectpicker").val('default');
        $(".selectpicker").selectpicker("refresh");
        $(".bootstrap-select").width("100%");
        reloadWithNewDropdowns();
    }

    jQuery(document).ready(function () {
        var projectStageSelectpickerOptions = {
            container: "body",
            width: "100%",
            noneSelectedText: "Filter by @FieldDefinitionEnum.ProjectStage.ToType().GetFieldDefinitionLabelPluralized()",
            actionsBox: true,
            selectedTextFormat: "count > 1",
            countSelectedText:  function (numSelected, numTotal) {
                if (numSelected === numTotal) {
                    return "All @FieldDefinitionEnum.ProjectStage.ToType().GetFieldDefinitionLabelPluralized()";
                }
                return numSelected + " of " + numTotal + " @FieldDefinitionEnum.ProjectStage.ToType().GetFieldDefinitionLabelPluralized()";
            }
        }

        var projectTypesSelectpickerOptions = {
            container: "body",
            width: "100%",
            //maxWidth: "330px",
            noneSelectedText: "Filter by Project Types",
            actionsBox: true,
            selectedTextFormat: "count > 1",
            countSelectedText:  function (numSelected, numTotal) {
                if (numSelected === numTotal) {
                    return "All Project Types";
                }
                return numSelected + " of " + numTotal + " Project Types";
            }
        }

        var projectCategoriesSelectpickerOptions = {
            container: "body",
            width: "100%",
            noneSelectedText: "Filter by Project Categories",
            actionsBox: true,
            selectedTextFormat: "count > 1",
            countSelectedText:  function (numSelected, numTotal) {
                if (numSelected === numTotal) {
                    return "All Project Categories";
                }
                return numSelected + " of " + numTotal + " Project Categories";
            }
        }

        var projectStagesDropdown = jQuery("#projectStageDropdown");
        var projectTypesDropdown = jQuery("#projectTypeDropdown");
        var projectCategoriesDropdown = jQuery("#projectCategoryDropdown");
        projectStagesDropdown.selectpicker(projectStageSelectpickerOptions);
        projectTypesDropdown.selectpicker(projectTypesSelectpickerOptions);
        projectCategoriesDropdown.selectpicker(projectCategoriesSelectpickerOptions);
        $(".selectpicker").selectpicker("refresh");

        jQuery(function() {
            jQuery('.counter').counterUp({
                delay: 10,
                time: 1000
            });
        });

        // since we are not using the onchange event, but only want to reload if there is a change after the drop down is closed,
        // need to keep track of the state of the drop downs separately
        var lastProjectStageIDs = jQuery("#projectStageDropdown").val();
        var lastProjectTypes = jQuery("#projectTypeDropdown").val();
        var lastProjectCategories = jQuery("#projectCategoryDropdown").val();
        $('.bootstrap-select').on('hide.bs.dropdown', function() {
            // check for changed lists
            var currentProjectStageIDs = jQuery("#projectStageDropdown").val();
            var currentProjectTypes = jQuery("#projectTypeDropdown").val();
            var currentProjectCategories = jQuery("#projectCategoryDropdown").val();
            if (lastProjectStageIDs.toString() !== currentProjectStageIDs.toString() || lastProjectTypes.toString() !== currentProjectTypes.toString() || lastProjectCategories.toString() !== currentProjectCategories.toString()) {
                reloadWithNewDropdowns();
            }
            lastProjectStageIDs = currentProjectStageIDs;
            lastProjectTypes = currentProjectTypes;
            lastProjectCategories = currentProjectCategories;
        });
    });

    // ]]>
</script>